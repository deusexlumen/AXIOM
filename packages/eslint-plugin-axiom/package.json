    "eslint": "^9.0.0"
  },
  "devDependencies": {
    "@types/eslint": "^9.6.1",
    "@typescript-eslint/parser": "^8.63.0",
    "@typescript-eslint/rule-tester": "^8.63.0",
    "eslint": "^9.24.0",
    "tsc-alias": "1.9.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
