{
  "name": "eslint-plugin-axiom",
  "version": "1.0.0",
  "description": "AXIOM invariant enforcement rules for ESLint 9",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
