{
  "name": "@axiom/cli",
  "version": "1.0.0",
  "description": "AXIOM agent-native framework CLI",
  "private": true,
  "type": "module",
  "bin": {
    "axm": "./dist/cli/bin.js"
  },
  "scripts": {
    "build": "tsc && tsc-alias",
    "test": "vitest run --reporter=json",
    "test:integration": "vitest run --reporter=json --config vitest.integration.config.ts src/cli/commands/init.integration.test.ts src/cli/commands/validate.integration.test.ts",
    "dev": "tsx src/cli/bin.ts"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "devDependencies": {
    "@types/node": "22.20.1",
    "execa": "^9.6.1",
    "fast-check": "^4.8.0",
    "tsc-alias": "1.9.0",
    "tsx": "4.23.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.2"
  }
}
